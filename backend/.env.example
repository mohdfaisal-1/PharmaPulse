# Groq API Key for LangChain Groq integration
GROQ_API_KEY=your_groq_api_key_here

# Default Model Selection
DEFAULT_MODEL=llama-3.1-8b-instant
REASONING_MODEL=llama-3.3-70b-versatile

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Database Configuration (PostgreSQL / MySQL / SQLite Fallback)
# Evaluators can configure custom connection URIs as needed:
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pharmapulse_db
# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/pharmapulse_db
# SQLite default fallback:
DATABASE_URL=sqlite:///./pharmapulse.db

